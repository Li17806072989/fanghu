# Copy to .env for local development. Never commit .env or real credentials.

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fang_hu
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
SA_TOKEN_JWT_SECRET=replace-with-a-random-32-byte-secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password

# Production requires a real SMS provider. The application refuses mock or plaintext-code configurations at startup.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=20
SMS_EXPOSE_CODE=false

# RuoYi backend
SERVER_PORT=8081
# Local Vue portal sends plain JSON over localhost. Enable only after the client implements RuoYi API encryption.
API_DECRYPT_ENABLED=false
LOGIN_ACCOUNT_ATTEMPT_LIMIT=10
LOGIN_IP_ATTEMPT_LIMIT=30
LOGIN_ATTEMPT_WINDOW_SECONDS=300
CAPTCHA_IP_REQUEST_LIMIT=60
CAPTCHA_REQUEST_WINDOW_SECONDS=60

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=replace-with-a-random-user
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=replace-with-a-random-user
MINIO_SECRET_KEY=change-me
FANGHU_MINIO_ACCESS_KEY=replace-with-a-random-user
FANGHU_MINIO_SECRET_KEY=change-me
MINIO_BUCKET=fanghu-private
MINIO_PRESIGN_EXPIRY_SECONDS=900

# ClamAV
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MILLIS=30000

# OpenAI-compatible AI provider
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# Production must keep administrator bootstrap disabled. Create administrators manually.
FANGHU_BOOTSTRAP_ADMIN_ENABLED=false
FANGHU_PAYMENT_MOCK_ENABLED=true
