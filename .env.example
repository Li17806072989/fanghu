# Copy to .env for local development. Never commit .env or real credentials.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=fang_hu
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=fanghu_admin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=fanghu_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=fanghu-private
MINIO_PRESIGN_EXPIRY_SECONDS=900

# ClamAV
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MILLIS=30000

# OpenAI-compatible AI provider
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# Local-only first administrator bootstrap. Never commit the actual value.
FANGHU_BOOTSTRAP_ADMIN_PASSWORD=change-me
